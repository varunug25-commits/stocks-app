{
  "expo": {
    "name": "Signal",
    "slug": "signal-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "signal",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.varun.signal"
    },
    "android": {
      "package": "com.varun.signal",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070B0D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
